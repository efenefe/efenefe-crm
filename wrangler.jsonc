{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "efenefe-crm",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Preview URLs are not covered by the Access login, so keep them off.
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: the first deploy creates this database automatically.
      "database_name": "efenefe-crm"
    }
  ],
  // Not secrets. Kept here because each deploy replaces variables set in the dashboard.
  "vars": {
    // From Cloudflare Zero Trust > Settings: "<team>.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "",
    // From the Access application's overview: "Application Audience (AUD) Tag"
    "ACCESS_AUD": ""
  }
}
