{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "efenefe-crm",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Preview URLs are not covered by the Access login, so keep them off.
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: the first deploy creates this database automatically.
      "database_name": "efenefe-crm"
    }
  ],
  // Login values (ACCESS_TEAM_DOMAIN, ACCESS_AUD) and the GOOGLE_PLACES_API_KEY secret are set in the
  // Cloudflare dashboard. keep_vars stops deploys from wiping them.
  "keep_vars": true,
  // Every minute, the Worker runs the next queued website audits (src/audit.js).
  "triggers": { "crons": ["* * * * *"] }
}
